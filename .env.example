PORT=5000

# Session pooler Supabase (menu Connect). Alamat koneksi langsung hanya IPv6 dan gagal dari Codespaces.
DATABASE_URL="postgresql://postgres.<kode-project>:<password>@aws-0-<wilayah>.pooler.supabase.com:5432/postgres"

# Supabase Auth: alamat project (Project Settings > API)
SUPABASE_URL="https://<kode-project>.supabase.co"

# Isi HANYA jika project memakai kunci legacy HS256 (Project Settings > JWT Keys).
# Untuk kunci asimetris (ECC/RSA) biarkan kosong; kunci publik diambil otomatis dari SUPABASE_URL.
SUPABASE_JWT_SECRET=
